# ---- TMDB credentials (use ONE of these) ----
# Get them free at https://www.themoviedb.org/settings/api
# v4 "API Read Access Token" (recommended)
TMDB_READ_TOKEN=
# or the v3 "API Key"
TMDB_API_KEY=

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (only needed if client is hosted on a different domain)
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Leave empty to use a local SQLite file (server/data/reelhunt.db).
# Set to a Postgres connection string (e.g. Neon/Render/Supabase) in production.
DATABASE_URL=

# ---- Upstream tuning (optional) ----
TMDB_TIMEOUT_MS=8000
TMDB_MAX_RPS=30
TMDB_MAX_CONCURRENCY=8
CACHE_MAX_ENTRIES=1000
